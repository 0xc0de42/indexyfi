# Python price server, used by the same-origin Next.js proxy (/backend/* -> PYTHON_API_URL).
PYTHON_API_URL=http://127.0.0.1:8000
# Optional: browser base URL for the price API. Defaults to the proxy (/backend).
# Point it at the server directly only if the page origin equals server.frontend_origin
# in backend/config.toml (default http://localhost:3000).
NEXT_PUBLIC_INDEXFI_API_URL=
NEXT_PUBLIC_BRAND_NAME=IndexFi
# Optional WalletConnect project ID; without it use an injected wallet.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional BSC testnet RPC URL (public client; never use a private API secret)
NEXT_PUBLIC_BSC_TESTNET_RPC_URL=
# Optional comma-separated chain-97 RPC list for failover; defaults to four keyless endpoints (see lib/vaults.ts).
NEXT_PUBLIC_VAULT_RPC_URLS=
# Contract deployment selection. Defaults to BSC testnet (97). The integration
# runner overrides these with chain 31337 and its isolated local RPC.
NEXT_PUBLIC_VAULT_CHAIN_ID=97
NEXT_PUBLIC_VAULT_RPC_URL=
# Optional manifest URL; defaults to /deployments/<chainId>.json.
NEXT_PUBLIC_VAULT_MANIFEST_URL=
# Server-only Atlas API key for /api/atlas/signed (signed prices injected into launch/deposit/redeem on chain 97).
# Never prefix with NEXT_PUBLIC_ and never commit a value. Not needed on the local fixture (chain 31337).
ATLAS_API_KEY=
