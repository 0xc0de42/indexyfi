# demo is explicit simulated data; api is read-only verified-backend mode.
NEXT_PUBLIC_DATA_MODE=demo
PYTHON_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BRAND_NAME=IndexFi
# Optional WalletConnect project ID; without it use an injected wallet.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional BSC testnet RPC URL (public client; never use a private API secret)
NEXT_PUBLIC_BSC_TESTNET_RPC_URL=
# Python server WebSocket that streams Atlas prices for the catalog feeds.
NEXT_PUBLIC_PRICE_WS_URL=ws://127.0.0.1:8000/ws/prices
